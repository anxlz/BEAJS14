{
  "name": "social-app",
  "version": "1.0.0",
  "description": "Social App - TypeScript, Express, MongoDB and Redis",
  "main": "dist/main.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "start:dev": "tsc && concurrently -k \"tsc --watch\" \"node --watch dist/main.js\"",
    "start:prod": "tsc && cross-env NODE_ENV=production node dist/main.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.0",
    "express": "^5.2.1",
    "google-auth-library": "^9.15.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.0",
    "nodemailer": "^10.2.1",
    "redis": "^5.8.2",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^6.4.17",
    "concurrently": "^9.0.0",
    "cross-env": "^10.1.0",
    "typescript": "^5.6.0"
  }
}
